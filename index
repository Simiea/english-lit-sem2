function words(t){return t.trim()?t.trim().split(/\s+/u).length:0}
let currentText=load('currentText','poem');if(!DATA[currentText])currentText='poem';let currentView='home';
function showView(view){if(!$(view))return;currentView=view;document.querySelectorAll('.view').forEach(x=>x.classList.toggle('active',x.id===view));document.querySelectorAll('.nav-btn').forEach(x=>x.classList.toggle('active',x.dataset.view===view));$('breadcrumb').textContent='Revision / '+({home:'Overview',learn:'Technique library',practice:'Practice texts',quiz:'Knowledge quiz',exam:'Exam strategy'}[view]);window.scrollTo({top:0,behavior:'instant'});store('lastView',view)}
document.querySelectorAll('.nav-btn').forEach(btn=>btn.addEventListener('click',()=>showView(btn.dataset.view)));document.querySelectorAll('.go').forEach(btn=>btn.addEventListener('click',()=>showView(btn.dataset.go)));
let currentFilter='All',visibleTerms=[],flashIndex=0,flashFlipped=false;
function getVisibleTerms(){const query=$('termSearch').value.toLowerCase().trim();visibleTerms=TERMS.filter(t=>(currentFilter==='All'||t[1]===currentFilter)&&(t.join(' ').toLowerCase().includes(query)));flashIndex=Math.min(flashIndex,Math.max(0,visibleTerms.length-1))}
function renderTerms(){getVisibleTerms();$('termCount').textContent=visibleTerms.length+' technique'+(visibleTerms.length===1?'':'s')+' shown';$('termGrid').innerHTML=visibleTerms.length?visibleTerms.map(t=>`<article class="term"><div class="top"><h3>${escapeHTML(t[0])}</h3><span class="tag gray">${escapeHTML(t[1])}</span></div><p>${escapeHTML(t[2])}</p><div class="sample">${escapeHTML(t[3])}</div></article>`).join(''):'<p class="muted">No techniques match. Try a shorter search or another category.</p>';renderFlash()}
$('termSearch').addEventListener('input',()=>{flashIndex=0;flashFlipped=false;renderTerms()});document.querySelectorAll('#termFilters .chip').forEach(btn=>btn.addEventListener('click',()=>{currentFilter=btn.dataset.filter;document.querySelectorAll('#termFilters .chip').forEach(b=>b.classList.toggle('active',b===btn));flashIndex=0;flashFlipped=false;renderTerms()}));
function renderFlash(){const t=visibleTerms[flashIndex];$('flashNumber').textContent=visibleTerms.length?`${flashIndex+1} / ${visibleTerms.length}`:'0 / 0';$('flashLabel').textContent=flashFlipped?'Definition + example':'What does this mean?';$('flashFront').textContent=t?(flashFlipped?t[2]:t[0]):'No matches';$('flashBack').textContent=t&&flashFlipped?t[3]:''}
function flip(){if(!visibleTerms.length)return;flashFlipped=!flashFlipped;renderFlash()}
$('flashcard').addEventListener('click',flip);$('flashcard').addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();flip()}});$('flashPrev').addEventListener('click',()=>{if(!visibleTerms.length)return;flashIndex=(flashIndex-1+visibleTerms.length)%visibleTerms.length;flashFlipped=false;renderFlash()});$('flashNext').addEventListener('click',()=>{if(!visibleTerms.length)return;flashIndex=(flashIndex+1)%visibleTerms.length;flashFlipped=false;renderFlash()});$('flashShuffle').addEventListener('click',()=>{for(let i=visibleTerms.length-1;i>0;i--){let j=Math.floor(Math.random()*(i+1));[visibleTerms[i],visibleTerms[j]]=[visibleTerms[j],visibleTerms[i]]}flashIndex=0;flashFlipped=false;renderFlash()});renderTerms();
function renderPractice(){const d=DATA[currentText];document.querySelectorAll('.text-tab').forEach(b=>b.classList.toggle('active',b.dataset.text===currentText));$('passageType').textContent=d.type;$('passageTitle').textContent=d.title;$('passageBody').innerHTML=d.html;
 $('questions').innerHTML=d.questions.map((q,i)=>`<div class="task-card"><div class="top"><span class="tag gray">Question ${i+1}</span> <span class="small muted">${escapeHTML(q.length)}</span></div><h3>${escapeHTML(q.q)}</h3><textarea aria-label="Answer to question ${i+1}" data-answer="${i}" placeholder="Write your response here. Start by answering the exact question…"></textarea><div class="q-footer"><span class="small muted" id="wc${i}">0 words · autosaved</span><div class="q-actions"><button class="btn tiny soft" data-hint="${i}">Hint</button><button class="btn tiny soft" data-model="${i}">Model answer</button></div></div><div class="hint hidden" id="hint${i}">${escapeHTML(q.hint)}</div><div class="model hidden" id="model${i}"><b>Example response:</b><p>${escapeHTML(q.model)}</p><div class="small muted">A model, not the only valid interpretation. Compare your choice of evidence and depth of analysis.</div></div><div class="self-check"><details><summary>Self-check before viewing the model</summary><label><input type="checkbox"> Technique or idea identified correctly</label><label><input type="checkbox"> Short, accurate evidence integrated</label><label><input type="checkbox"> Effect and wider idea explained</label><label><input type="checkbox"> Wording answers the exact question</label></details></div></div>`).join('');
 document.querySelectorAll('[data-answer]').forEach(area=>{const i=Number(area.dataset.answer);area.value=load('answer_'+currentText+'_'+i,'');const update=()=>{$('wc'+i).textContent=words(area.value)+' words · autosaved';store('answer_'+currentText+'_'+i,area.value)};area.addEventListener('input',update);update()});
 document.querySelectorAll('[data-hint]').forEach(b=>b.addEventListener('click',()=>{$('hint'+b.dataset.hint).classList.toggle('hidden');b.textContent=$('hint'+b.dataset.hint).classList.contains('hidden')?'Hint':'Hide hint'}));
 document.querySelectorAll('[data-model]').forEach(b=>b.addEventListener('click',()=>{$('model'+b.dataset.model).classList.toggle('hidden');b.textContent=$('model'+b.dataset.model).classList.contains('hidden')?'Model answer':'Hide model'}));
}
document.querySelectorAll('.text-tab').forEach(b=>b.addEventListener('click',()=>{currentText=b.dataset.text;store('currentText',currentText);renderPractice()}));renderPractice();
const compare=$('compareAnswer');compare.value=load('comparison','');function saveCompare(){store('comparison',compare.value);$('compareWords').textContent=words(compare.value)+' words · autosaved'}compare.addEventListener('input',saveCompare);saveCompare();$('compareHint').addEventListener('click',()=>$('compareHintBox').classList.toggle('hidden'));$('compareModel').addEventListener('click',()=>$('compareModelBox').classList.toggle('hidden'));
function download(name,text){const blob=new Blob([text],{type:'text/plain;charset=utf-8'}),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download=name;document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),2000)}
$('exportText').addEventListener('click',()=>{let d=DATA[currentText],body=`CRITICAL READING LAB — ${d.title}\nOriginal ${d.type} practice\n\n`;d.questions.forEach((q,i)=>body+=`QUESTION ${i+1}: ${q.q}\n\n${load('answer_'+currentText+'_'+i,'')||'(Not answered)'}\n\n`);download('critical-reading-'+currentText+'-answers.txt',body)});
$('exportCompare').addEventListener('click',()=>download('critical-reading-comparison.txt','CRITICAL READING LAB — COMPARISON TASK\nCompare how any two original practice texts explore change and attachment.\n\n'+compare.value));
let remaining=25*60,timerId=null,timerRunning=false;function displayTimer(){$('timerDisplay').textContent=String(Math.floor(remaining/60)).padStart(2,'0')+':'+String(remaining%60).padStart(2,'0')};function stopTimer(){if(timerId)clearInterval(timerId);timerId=null;timerRunning=false;$('timerStart').textContent='Start'}
$('timerStart').addEventListener('click',()=>{if(timerRunning){stopTimer();$('timerStatus').textContent='Paused';return}if(remaining===0)remaining=Number($('timerPreset').value)*60;timerRunning=true;$('timerStart').textContent='Pause';$('timerStatus').textContent='In progress';timerId=setInterval(()=>{remaining=Math.max(0,remaining-1);displayTimer();if(!remaining){stopTimer();$('timerStatus').textContent='Time complete — review your answer';$('timerStart').textContent='Start'}},1000)});
function resetTimer(){stopTimer();remaining=Number($('timerPreset').value)*60;displayTimer();$('timerStatus').textContent='Ready'}$('timerReset').addEventListener('click',resetTimer);$('timerPreset').addEventListener('change',resetTimer);displayTimer();
let quizAnswers=Array(QUIZ.length).fill(null),quizMarked=false;
function renderQuiz(){let html='';QUIZ.forEach((q,i)=>{html+=`<div class="quiz-question"><span class="tag gray">Question ${i+1} of ${QUIZ.length}</span><h3 style="margin-top:10px">${escapeHTML(q[0])}</h3><div role="group" aria-label="Question ${i+1} options">`;q[1].forEach((opt,j)=>{const chosen=quizAnswers[i]===j;let cls=chosen?' selected':'';if(quizMarked&&j===q[2])cls+=' right';else if(quizMarked&&chosen&&j!==q[2])cls+=' wrong';html+=`<button class="option${cls}" data-qi="${i}" data-oi="${j}" aria-pressed="${chosen}" ${quizMarked?'disabled':''}><span class="abc">${'ABCD'[j]}</span>${escapeHTML(opt)}</button>`});html+='</div>';if(quizMarked)html+=`<div class="quiz-exp"><b>${quizAnswers[i]===q[2]?'Correct.':'Explanation:'}</b> ${escapeHTML(q[3])}</div>`;html+='</div>'});$('quizContainer').innerHTML=html;document.querySelectorAll('[data-qi]').forEach(b=>b.addEventListener('click',()=>{quizAnswers[Number(b.dataset.qi)]=Number(b.dataset.oi);renderQuiz()}));let n=quizAnswers.filter(x=>x!==null).length;$('quizProgressText').textContent=n+' of '+QUIZ.length+' answered';$('quizProgressBar').style.width=(n/QUIZ.length*100)+'%';$('quizSubmit').disabled=quizMarked;$('quizSubmit').textContent=quizMarked?'Answers marked':'Mark my answers'}
$('quizSubmit').addEventListener('click',()=>{if(quizMarked)return;quizMarked=true;const score=quizAnswers.reduce((s,x,i)=>s+Number(x===QUIZ[i][2]),0);$('quizResult').innerHTML=`<div class="quiz-summary"><div class="eyebrow">Knowledge quiz result</div><h2 style="margin-top:5px">${score} / ${QUIZ.length} correct</h2><p>${score>=13?'Excellent technique recognition.':score>=10?'Good foundation. Review your missed concepts.':'Review the definitions and examples in the technique library, then retry.'} Your written analysis still needs practice beyond this multiple-choice result.</p><button class="btn tiny soft go" id="goLearnAfter">Revise techniques →</button></div>`;$('goLearnAfter').addEventListener('click',()=>showView('learn'));renderQuiz();$('quizResult').scrollIntoView({behavior:'smooth',block:'center'})});
$('quizReset').addEventListener('click',()=>{quizAnswers=Array(QUIZ.length).fill(null);quizMarked=false;$('quizResult').innerHTML='';renderQuiz();window.scrollTo({top:0,behavior:'smooth'})});renderQuiz();
// Restore section preference, without requiring a network or account.
const resume=load('lastView','home');if(['home','learn','practice','quiz','exam'].includes(resume))showView(resume);
</script>
</body>
</html>
